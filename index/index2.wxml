<view class="rank-container">
  <view class="header">
    <text class="header-title">排行榜</text>
  </view>

  <!-- 歌曲选择器 -->
  <picker mode="selector" range="{{songList}}" range-key="name" value="{{songIndex}}" bindchange="onSongChange">
    <view class="picker-box">
      当前歌曲：{{songList[songIndex].name}}
    </view>
  </picker>

  <!-- 用户当前排名 -->
  <view class="user-status" wx:if="{{userRank || userScore}}">
    <text wx:if="{{userRank}}">您当前排名：第 {{userRank}} 名 | 分数：{{userScore}}</text>
    <text wx:else>您未上榜 | 得分：{{userScore}}</text>
  </view>

  <!-- 排行榜列表 -->
  <scroll-view scroll-y class="rank-list">
    <view wx:for="{{rankList}}" wx:key="rank" class="rank-item">
      <view class="rank-num">{{item.rank}}</view>
      <image class="avatar" src="{{item.avatar || '/images/default_avatar.png'}}" />
      <view class="rank-info">
        <text class="nick">{{item.name}}</text>
        <text class="score">{{item.score}} 分</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{rankList.length === 0}}" class="empty">
      <text>暂无数据</text>
    </view>
  </scroll-view>
</view>
