.playing-container {
  height: 100vh; /* 改为固定高度 */
  padding: 20rpx 40rpx; /* 缩小上下内边距 */
  background: #a3d5ff; /* 淡蓝色背景 */
  color: white;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.music-info {
  text-align: center;
  margin-top: 20rpx; /* 减小顶部间距 */
}

.album-cover {
  width: 200rpx; /* 缩小专辑图 */
  height: 200rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.3);
}

.music-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.music-author {
  font-size: 28rpx;
  opacity: 0.8;
}

.progress-section {
  margin: 20rpx 0;
}

.progress-bar {
  width: 100%;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 3rpx;
  margin-bottom: 10rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: #ffffff;
  border-radius: 3rpx;
  transition: width 0.3s;
}

.time-info {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  opacity: 0.7;
}

.control-section {
  margin-bottom: 20rpx;
}

.volume-control {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.volume-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  margin: 0 20rpx;
  transition: all 0.3s;
}

.volume-btn:active {
  background: rgba(255, 255, 255, 0.2);
}

.volume-text {
  font-size: 24rpx;
  opacity: 0.8;
}

.play-control {
  display: flex;
  align-items: center;
  justify-content: center;
}

.control-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 20rpx;
  transition: all 0.3s;
}

.control-btn:active {
  opacity: 0.7;
}

.play-btn {
  width: 100rpx;
  height: 100rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.3);
  transition: all 0.3s;
}

.play-btn.playing {
  background: #ff6b6b;
}

.play-btn:active {
  transform: scale(0.95);
}
